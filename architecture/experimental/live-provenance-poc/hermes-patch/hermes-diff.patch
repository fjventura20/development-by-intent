+    def _handle_session_key_prove_command(self, cmd_original: str):
+        """EXPERIMENTAL: ephemeral per-session identity primitive.
+
+        Behind config flag experimental.ephemeral_session_identity.
+        See hermes_cli/ephemeral_session_id_poc.py.
+        """
+        import sys
+        from cli import _cprint
+        from hermes_cli.ephemeral_session_id_poc import (
+            _main as _eph_main, is_enabled,
+        )
+        if not is_enabled():
+            _cprint("  ephemeral_session_identity is disabled.")
+            _cprint("  Set experimental.ephemeral_session_identity: true in config.yaml")
+            return
+        # Re-route to the ephemeral module's CLI
+        # The first arg should be 'session-key-prove' for proper routing
+        # but _main expects argv without program name; pass ['session-key-prove', ...rest]
+        parts = cmd_original.split()
+        # parts[0] is 'session-key-prove'
+        rc = _eph_main(["eph"] + parts)
+        if rc != 0:
+            sys.stderr.write(f"  exit {rc}\n")
+
     def _cmd_title(self, cmd_original: str):
         from cli import _cprint
         from hermes_state import format_session_db_unavailable
